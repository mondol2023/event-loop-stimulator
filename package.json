    "@uiw/react-codemirror": "^4.25.12",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "ioredis": "^6.0.0",
    "iron-session": "^9.0.1",
    "lucide-react": "^1.52.0",
    "mongoose": "^9.10.4",
    "motion": "^14.0.0",
    "nanoid": "^6.0.1",
    "next": "16.3.8",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",

import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";
import { EXAMPLE_CONFIGS, type Example, type ExampleConfig } from "../features/playground/examples/examples.config.ts";
import { parseExpectation } from "./conformance/expectation.mts";
import { readTarget, type Target } from "./conformance/target.mts";

// `npm run examples:sync`: rebuilds features/playground/examples/catalog.generated.ts from the
// recorded conformance fixtures (the playground's examples ARE fixtures, so the "Matches Node vX"
// badge is backed by a real recording). It only reads files and writes the catalog; it never runs
// any program. The output is deterministic, and tests/conformance/examples.test.ts fails on drift.

const REPO_ROOT = join(fileURLToPath(new URL(".", import.meta.url)), "..");
export const CATALOG_PATH = "features/playground/examples/catalog.generated.ts";

export type BuildOptions = {
  /** The repository root. */
  readonly root: string;
  /** The pinned runtime (docs/TARGET.md); an expectation recorded elsewhere does not verify. */
  readonly target: Target;
  readonly configs?: readonly ExampleConfig[];
};

function fixtureFile(root: string, stem: string): { path: string; lang: "js" | "ts" } {
  for (const [ext, lang] of [
    ["cjs", "js"],
    ["cts", "ts"],
  ] as const) {
    const path = join(root, "tests", "conformance", "fixtures", `${stem}.${ext}`);
    if (existsSync(path)) return { path, lang };
  }
  throw new Error(`examples: no fixture "${stem}" in tests/conformance/fixtures/ (.cjs or .cts)`);
}

export function buildExamples({ root, target, configs = EXAMPLE_CONFIGS }: BuildOptions): Example[] {
  return configs.map((config) => {
    const { path, lang } = fixtureFile(root, config.fixture);
    const expectedPath = path.replace(/\.(cjs|cts)$/, ".expected.json");
    const expectation = existsSync(expectedPath) ? parseExpectation(JSON.parse(readFileSync(expectedPath, "utf8"))) : null;
    const onPinned = expectation !== null && expectation.target.node === target.node && expectation.target.v8 === target.v8;
    return {
      id: config.id,
      title: config.title,
      fixture: config.fixture,
      blurb: config.blurb,
      source: readFileSync(path, "utf8"),
      lang,
      verified: onPinned ? { node: expectation.target.node, v8: expectation.target.v8 } : null,
      nondeterministic: expectation?.nondeterministic ?? false,
    };
  });
}

/** The exact text of catalog.generated.ts (LF line endings, trailing newline). */
export function renderCatalog(examples: readonly Example[]): string {
  return [
    "// generated by npm run examples:sync; do not edit",
    "// Source: tests/conformance/fixtures/*.cjs|cts and their recorded *.expected.json; list: examples.config.ts.",
    'import type { Example } from "./examples.config";',
    "",
    `export const EXAMPLES: readonly Example[] = ${JSON.stringify(examples, null, 2)};`,
    "",
  ].join("\n");
}

// Only when run directly (`node scripts/examples-sync.mts`), not when a test imports the builders.
if (process.argv[1] !== undefined && import.meta.url === pathToFileURL(process.argv[1]).href) {
  const examples = buildExamples({ root: REPO_ROOT, target: readTarget() });
  writeFileSync(join(REPO_ROOT, CATALOG_PATH), renderCatalog(examples));
  const verified = examples.filter((e) => e.verified !== null).length;
  console.log(`Wrote ${CATALOG_PATH}: ${examples.length} examples, ${verified} verified on the pinned runtime.`);
}

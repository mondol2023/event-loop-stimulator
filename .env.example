# Copy to .env.local and fill in. Validated on boot by server/env.ts.

# MongoDB must run as a replica set (transactions). `docker compose up -d` gives you one.
MONGODB_URI=mongodb://localhost:27017/silicon-loop?replicaSet=rs0

# >= 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional: enables the Redis rate-limit store (in-memory store is dev-only).
# Start with: docker compose --profile redis up -d
REDIS_URL=

# Optional: `npm run seed` promotes this email to admin, but only if that user has
# already registered. The seed never creates users. Re-run it after they sign up.
ADMIN_BOOTSTRAP_EMAIL=
